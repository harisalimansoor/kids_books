# ==============================================================================
# MyInteliBooks - Environment Configuration Example
# Copy this file to .env and configure your OpenRouter API key.
# ==============================================================================

# Required: OpenRouter API key for AI-generated illustrations and front covers
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here

# Optional: AI Image Generation Model (Default: openai/gpt-image-2)
IMAGE_GEN_MODEL=openai/gpt-image-2

# Optional: Maximum retry attempts for image generation API calls (Default: 3)
IMAGE_GEN_MAX_ATTEMPTS=3

# Optional: OpenAI / Gemini when switching providers from the admin panel
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: SMTP used to send feedback emails FROM support@myintelibooks.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=support@myintelibooks.com
SMTP_PASSWORD=
SMTP_FROM=support@myintelibooks.com

# Optional: IMAP inbox to ingest replies sent to support@myintelibooks.com
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=support@myintelibooks.com
IMAP_PASSWORD=

# Public URL used inside feedback emails (set this to your deployed site)
PUBLIC_BASE_URL=http://localhost:5173
